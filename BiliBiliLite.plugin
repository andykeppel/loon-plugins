#!name=哔哩哔哩 Lite
#!desc=墨鱼 Bilibili 精简去广告
#!author=ddgksf2013
#!homepage=https://github.com/ddgksf2013
#!openUrl=https://apps.apple.com/cn/app/id736536022
#!icon=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/icons/BiliBili.png?v=official-20261110
#!tag=ddgksf2013


[Rewrite]
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show - reject-200

[Script]
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

http-response ^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/square script-path=https://raw.githubusercontent.com/andykeppel/loon-plugins/main/scripts/bilibili.ads.js, requires-body=true, timeout=60, tag=bilibili.ads

[MITM]
hostname = app.bilibili.com
