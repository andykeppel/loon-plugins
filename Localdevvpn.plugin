#!name = Localdevvpn
#!desc = 为 10.7.0.1 启用本机回环；按参考实现关闭 IPv6 VIF（会影响整个 Loon 的 IPv6 TUN）。
#!author = andykeppel
#!homepage = https://apps.apple.com/us/app/localdevvpn/id6755608044
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f9/0c/c0/f90cc0a7-6cf8-902c-11ce-5e5fa4ea2731/AppIcon-0-1x_U007epad-0-1-85-220-0.png/512x512bb.jpg
#!system = iOS,iPadOS
#!loon_version = 3.5.3(1007)
#!date = 2026-11-15
#!tag = 开发工具,本机回环
#!type = normal

# Based on bb's dev-loopback implementation:
# https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/dev-loopback/modules/dev-loopback.lpx
# Keep this repository's Localdevvpn identity, icon, App Store homepage and import URL.
# IMPORTANT: ipv6-vif = off disables the Loon IPv6 TUN interface globally while enabled.
# It is not scoped to 10.7.0.1. Turn off this plugin if native IPv6 TUN routing is needed.
# IP Rewrite affects ALL apps accessing 10.7.0.1 while this plugin is enabled.
# No DNS, proxy rules, MITM, scripts, or other target IPs are added.
# The loopback target cannot be changed by a Loon [Argument] control.
# App Store: https://apps.apple.com/us/app/localdevvpn/id6755608044

[General]
ipv6-vif = off
include-tun = 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
